{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lantai",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 1 * * *"]
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // 静态资产恢复边缘直出：只有下列路径强制**先过 Worker**（闭集白名单，不是通配拦截）。
    // - /api/*：全部接口；
    // - 受保护后台页必须留在白名单，否则 assets 的 html_handling 会把 /admin
    //   直接映射成 public/admin.html 吐给匿名访客，绕过 accessGuard；
    // - 8 条公开读取族路径显式列入：读取出口与 `.json` 守卫因此对 `.json` 请求具备权威性
    //   （契约 §1.1 的维护约束——将来往 public/ 加 .json 资产必须先给守卫加白名单——依赖这点）。
    //   **严禁**改成 `/*.json` 之类的通配：那会把将来加入 public/ 的真实 .json 资产一并吞掉。
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin.html",
      "/review",
      "/review.html",
      "/ops",
      "/ops.html",
      // - 平台页面路径（无扩展名入口）：GET 仍由资产层的 html_handling 提供（Worker 只是透传），
      //   但它们必须先过 Worker，否则**非 GET/HEAD 的方法**（例如 `POST /dataset`）会被资产层
      //   以「405 + 非 JSON」应答，而契约 §1.3 / E31-⑤ 要求「非读取族、非 `.json` 的方法
      //   一律 404 + no-store 且不带 allow」——只在 Worker 里兜得住。
      //   **静态资源**（`styles.css` / `app.js` / 图片等）不进白名单，保持边缘直出，缓存与命中路径不变。
      "/",
      "/search",
      "/submit",
      "/status",
      "/dataset",
      "/index.json",
      "/search/index.json",
      "/*/manifest.json",
      "/*/latest.json",
      "/*/preview.json",
      "/*/search-index.json",
      "/*/versions/*.json",
      "/schemas/*/*.json"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lantai",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "lantai",
      "preview_bucket_name": "lantai-preview"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "SKIP_ACCESS_DEV": "true",
    "TURNSTILE_SITE_KEY": "",
    "IP_HASH_SALT": "dev-salt"
  },
  "env": {
    "test": {
      "name": "lantai-test",
      // 每次 deploy 都会把 workers.dev 裸域重新打开（wrangler 默认行为，会打警告）；
      // 这里显式关掉，避免部署后裸域绕过边缘 Access 暴露后台。
      "workers_dev": false,
      "vars": {
        // `/{slug}/latest.json` 302 跳包本体的白名单（见 src/index.ts maybeRedirectLatest）
        "LATEST_REDIRECT_SLUGS": "channel-preset-pack",
        "ENVIRONMENT": "test",
        "SKIP_ACCESS_DEV": "true",
        "TURNSTILE_SITE_KEY": "",
        "IP_HASH_SALT": "dev-salt"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lantai-test",
          "database_id": "6c013211-e179-4644-8527-08a5d190f470",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "lantai-test",
          "preview_bucket_name": "lantai-test-preview"
        }
      ]
    },
    "preprod": {
      "name": "lantai-preprod",
      "vars": {
        "ENVIRONMENT": "preprod",
        "SKIP_ACCESS_DEV": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lantai-preprod",
          "database_id": "11111111-1111-1111-1111-111111111111",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "lantai-preprod",
          "preview_bucket_name": "lantai-preprod-preview"
        }
      ]
    },
    "production": {
      "name": "lantai",
      "vars": {
        "ENVIRONMENT": "production",
        "SKIP_ACCESS_DEV": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lantai-prod",
          "database_id": "22222222-2222-2222-2222-222222222222",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "lantai-prod",
          "preview_bucket_name": "lantai-prod-preview"
        }
      ]
    }
  }
}
