{
  "name": "lantai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LanTai 兰台 — 公开数据发布与共享平台（Cloudflare 免费额度）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:preprod": "wrangler deploy --env preprod",
    "deploy:prod": "wrangler deploy --env production",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:preprod": "wrangler d1 migrations apply DB --env preprod --remote",
    "db:migrate:prod": "wrangler d1 migrations apply DB --env production --remote",
    "seed:demo": "node scripts/seed-demo.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "publish:preset-pack": "node scripts/publish-preset-pack.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@cloudflare/vitest-pool-workers": "0.9.14",
    "@cloudflare/workers-types": "^4.20251011.0",
    "typescript": "^5.7.2",
    "vitest": "~3.2.0",
    "wrangler": "4.44.0"
  }
}
